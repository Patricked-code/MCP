{
  "name": "wealthtech-mcp-ssh-bridge",
  "version": "0.1.0",
  "description": "MCP SSH Bridge sécurisé pour piloter les serveurs WealthTech S1/S2 avec des outils contrôlés, journalisés et documentés.",
  "type": "module",
  "private": false,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:secrets": "node scripts/check-no-secrets.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-doc-governance.mjs && node scripts/check-function-cartography.mjs && npm run program:readiness",
    "current-state:evidence": "node scripts/current-state-evidence.mjs",
    "cartography:check": "node scripts/check-function-cartography.mjs",
    "cartography:write": "node scripts/check-function-cartography.mjs --write",
    "gwc:verify": "node scripts/gwc-verify.mjs && node scripts/gwc-precode-verify.mjs",
    "test:governance": "tsx --test tests/docGovernance.test.ts",
    "test:readonly-safety": "node scripts/run-validation-tests.mjs tests/githubRepositoryResolution.test.ts",
    "program:readiness": "node scripts/program-backlog-readiness.mjs --check",
    "program:readiness:write": "node scripts/program-backlog-readiness.mjs --write",
    "program:next": "node scripts/program-backlog-readiness.mjs --next"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "latest",
    "express": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "ssh2": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/ssh2": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1",
    "hono": "4.12.34",
    "@hono/node-server": "2.0.12"
  },
  "mcpValidationProfile": {
    "schemaVersion": 1,
    "profileId": "mcp-ci-v1",
    "projectId": "mcp",
    "repository": "Patricked-code/MCP",
    "ci": {
      "workflow": "MCP CI",
      "job": "validate"
    },
    "validationScripts": [
      {
        "id": "typecheck",
        "script": "typecheck"
      },
      {
        "id": "build",
        "script": "build"
      },
      {
        "id": "docs-check",
        "script": "docs:check"
      },
      {
        "id": "governance-tests",
        "script": "test:governance"
      },
      {
        "id": "gwc-verify",
        "script": "gwc:verify"
      },
      {
        "id": "secret-scan",
        "script": "lint:secrets"
      },
      {
        "id": "read-only-safety",
        "script": "test:readonly-safety"
      }
    ],
    "workflowNativeChecks": [
      "whitespace-diff"
    ],
    "testDiscovery": {
      "root": "tests",
      "suffix": ".test.ts",
      "runnerScript": "test:readonly-safety",
      "dedicated": [
        {
          "path": "tests/docGovernance.test.ts",
          "script": "test:governance"
        }
      ]
    }
  }
}
