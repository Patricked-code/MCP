GITHUB_TOKEN_FILE=/app/secrets/github_token
GITHUB_API_BASE=https://api.github.com
GITHUB_API_ALLOWED_HOSTS=api.github.com
GITHUB_REQUEST_TIMEOUT_MS=15000

# Domains protégés et conservés. Ne pas modifier ici sans mettre à jour docs/GPT.md et docs/SUIVI.md.
PROTECTED_MODE=read_only_first
