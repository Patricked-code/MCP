NODE_ENV=production
PORT=8787
MCP_AUTH_TOKEN=change_me_with_a_long_random_secret
LOG_LEVEL=info

S1_HOST=212.227.212.33
S1_PORT=22
S1_USER=root
S1_KEY_PATH=/opt/apps/wealthtech-mcp-ssh-bridge/keys/s1_mcp_key

S2_HOST=217.160.249.254
S2_PORT=22
S2_USER=root
S2_KEY_PATH=/opt/apps/wealthtech-mcp-ssh-bridge/keys/s2_mcp_key

# GitHub : le credential reste dans /app/secrets et n'est jamais versionné.
GITHUB_ORG=
GITHUB_TOKEN_FILE=/app/secrets/github_token
GITHUB_API_BASE=https://api.github.com
GITHUB_API_ALLOWED_HOSTS=api.github.com
GITHUB_REQUEST_TIMEOUT_MS=15000

# Optional GitHub App credentials for GRT pilot. All three required to opt in.
# Key must be a private mode-0600 file under /app/secrets; never commit it.
MCP_GRT_GITHUB_APP_ID=
MCP_GRT_GITHUB_INSTALLATION_ID=
MCP_GRT_GITHUB_APP_KEY_FILE=

# GRT pilot: private /app/data/gouvern archive and operator-only /gouvern route
MCP_GOUVERN_PILOT_ENABLED=false

# Plesk provisioning (opt-in, empty scope by default, no migration)
MCP_PLESK_PROVISIONING_ENABLED=false
MCP_PLESK_ALLOWED_PARENTS=

# Domains protégés et conservés. Ne pas modifier ici sans mettre à jour docs/GPT.md et docs/SUIVI.md.
PROTECTED_MODE=read_only_first
