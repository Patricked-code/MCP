{
  "schemaVersion": 1,
  "policyId": "github-first-operational-continuity-v1",
  "mode": "GITHUB_FIRST_OPERATIONAL_CONTINUITY",
  "selectableProfiles": {
    "EXTERNAL_GOVERNED_RECOVERY": {
      "id": "EXTERNAL_GOVERNED_RECOVERY",
      "label": "Bifurcation externe gouvernée — GitHub-first / OIDC / Non-régression",
      "kind": "SELECTABLE_NON_AUTHORITATIVE_OPERATING_PROCEDURE",
      "enabledForExplicitSelection": true,
      "selectedByDefault": false,
      "executionEngineCreated": false,
      "runtimeWritePermissionGranted": false,
      "taskSessionOrLockCreated": false,
      "policyAuthority": "GITHUB_FIRST_OPERATIONAL_CONTINUITY",
      "runbook": "docs/runbooks/GITHUB_FIRST_GOVERNED_RECOVERY.md",
      "allowedSelectionReasons": [
        "OWNER_EXPLICITLY_REQUESTS_EXTERNAL_GOVERNED_RECOVERY",
        "NORMAL_MCP_ADMISSION_OR_OAUTH_PATH_UNAVAILABLE",
        "BOUNDED_MCP_REPAIR_OR_EXTENSION_REQUIRES_GITHUB_FIRST_CONTINUITY"
      ],
      "transportOrder": [
        "GITHUB_ONLY",
        "GITHUB_ACTION_READONLY_EVIDENCE",
        "GITHUB_ACTION_BOUNDED_WRITE",
        "RUNTIME_REQUIRED"
      ],
      "mandatoryGates": [
        "EXACT_HEAD_AND_BRANCH_REOBSERVED",
        "CANONICAL_ISSUE_AND_EXISTING_PR_REUSED",
        "OWNERSHIP_COLLISION_DEPENDENCY_CHECKED",
        "NO_RUNTIME_AUTHORITY_INFERRED_FROM_GITHUB_ACCESS",
        "NO_SERVER_MUTATION_FROM_READONLY_EVIDENCE",
        "CI_AND_REQUIRED_REVIEWS_ON_EXACT_SHA",
        "EXISTING_GOVERNED_DEPLOY_WITH_ATTESTATION_ONLY_IF_ADMITTED",
        "CHECKPOINT_AND_RETURN_TO_NORMAL_GOVERNANCE"
      ],
      "forbidden": [
        "BYPASS_E3_OAUTH_OIDC_TASK_SESSION_LOCK",
        "GITHUB_DIRECT_MAIN_PUSH",
        "SERVER_DIRECT_VERSIONED_SOURCE_EDIT",
        "UNBOUNDED_SHELL_OR_PRIVILEGE_ESCALATION",
        "FAKE_REVIEW_FAKE_CLAIM_OR_UNVERIFIED_DEPLOY",
        "PARALLEL_DISPATCHER_OR_NEW_CANONICAL_AUTHORITY"
      ],
      "scope": "Selection of existing transport and governance controls only; no automatic branch, PR, production write, merge or deployment.",
      "repositoryScope": "MCP_GLOBAL_ALL_WORKSTREAMS",
      "implementationStatus": "AGENT_READABLE_CONFIG_AND_RUNBOOK_ONLY_NOT_AUTOMATIC_RUNTIME_SELECTION",
      "selectionContract": {
        "requestedInOwnerMandate": true,
        "procedureLoadedByAgent": true,
        "selectedProfileRecordedInExistingIssueOrPrCheckpoint": true,
        "actualTransportDecidedPerOperationFromExistingPermissions": true,
        "automaticallyProcessedByRuntime": false,
        "noNewTaskQueueOrWorker": true,
        "noRuntimeAccessIfRequiredAuthorityUnavailable": true
      },
      "constructionMethodRelationship": {
        "independentOfConstructionMethods": true,
        "mayCoexistWith": "GD-U-METHOD-20261028-01",
        "scopedMethodSource": "docs/governance/universal-capabilities-bifurcation-20261028.json#workingMethodology",
        "scopedMethodOnlyFor": "GOVERNED_DEPLOY_UNIVERSAL_ISSUE_349",
        "rule": "Select transport/profile per operation; preserve each workstream's own construction methodology, continuity ID, ownership, PR and execution authority."
      }
    }
  },
  "bootstrap": {
    "githubConnectionSufficient": true,
    "runtimeMcpIsBootstrapPrerequisite": false,
    "bridgeExposureDefault": false,
    "rule": "Preserve the GitHub client surface by default. Resolve the next bounded operation through GitHub first, then an approved GitHub Actions fallback. Request/expose runtime bridge capability only when the exact operation requires live runtime authority and no approved GitHub fallback can complete it."
  },
  "executionModes": {
    "GITHUB_ONLY": {
      "runtimeMcpRequired": false,
      "examples": [
        "repository_read",
        "branch_write",
        "pull_request",
        "ci",
        "review",
        "merge_evidence",
        "canonical_memory_read"
      ]
    },
    "GITHUB_ACTION_READONLY_EVIDENCE": {
      "runtimeMcpRequired": false,
      "workflow": ".github/workflows/mcp-readonly-evidence.yml",
      "trigger": "github_issue",
      "issueTitle": "MCP_READONLY_EVIDENCE_REQUEST",
      "mutationAllowed": false,
      "primaryTransport": "github_oidc_mcp_readonly",
      "primaryEndpoint": "https://mcp.wealthtechinnovations.com/evidence/github/readonly",
      "sshFallback": "protected_environment_only_after_oidc_failure",
      "runtimeInteractiveAuthRequired": false,
      "stablecoinReconciliationProbes": [
        "stablecoin_frontend_git_status",
        "stablecoin_backend_git_status",
        "stablecoin_backend_inventory",
        "stablecoin_runtime_status"
      ],
      "backendInventoryOutputPolicy": {
        "secretValuesAllowed": false,
        "envFileReadsAllowed": false,
        "processEnvironmentReadsAllowed": false,
        "rawSourceOutputAllowed": false,
        "allowedDerivedMetadata": [
          "package_identity",
          "repository_hint",
          "dependency_versions",
          "known_path_presence",
          "file_sha256",
          "env_reference_names",
          "database_dialect_hint",
          "database_name_literal_if_nonsecret",
          "filesystem_uid_gid_mode"
        ],
        "sshFallback": "fail_closed_if_primary_oidc_unavailable"
      },
      "operationalAuthorityProbes": [
        "mcp_governed_tasks",
        "mcp_governed_sessions",
        "mcp_governed_locks"
      ],
      "operationalAuthorityOutputPolicy": {
        "rawStoreDocumentsAllowed": false,
        "rawPrincipalIdentityAllowed": false,
        "rawResumeSecretAllowed": false,
        "freeFormTaskTextAllowed": false,
        "recordProjection": "collision_and_ownership_metadata_only",
        "recordLimitBehavior": "TRUNCATED_TRUE_FAIL_CLOSED",
        "sshFallback": "FAIL_CLOSED_OIDC_ENDPOINT_REQUIRED"
      },
      "registryEvidenceProbes": [
        "mcp_git_registry_readiness"
      ],
      "registryEvidenceOutputPolicy": {
        "authority": "GitRegistry V2",
        "projection": "mapping_id_readiness_reason_codes_and_digests_only",
        "repositoryIdentifiersAllowed": false,
        "projectNamesAllowed": false,
        "serverPathsAllowed": false,
        "domainsAllowed": false,
        "credentialReferencesAllowed": false,
        "unsafeMappingIdBehavior": "REPLACED_BY_SHA256_DIGEST",
        "recordLimit": 200,
        "recordLimitBehavior": "TRUNCATED_TRUE",
        "sshFallback": "FAIL_CLOSED_OIDC_ENDPOINT_REQUIRED"
      }
    },
    "RUNTIME_REQUIRED": {
      "runtimeMcpRequired": true,
      "examples": [
        "operational_memory_mutation",
        "governed_lock_mutation",
        "server_write_without_approved_github_bounded_write",
        "runtime_tool_invocation_without_github_fallback"
      ]
    },
    "GITHUB_ACTION_BOUNDED_WRITE": {
      "runtimeMcpRequired": false,
      "workflow": ".github/workflows/stablecoin-fast-forward.yml",
      "trigger": "github_issue",
      "issueTitle": "MCP_STABLECOIN_FAST_FORWARD_REQUEST",
      "mutationAllowed": true,
      "operation": "stablecoin_frontend_fast_forward",
      "primaryTransport": "github_oidc_mcp_bounded_write",
      "primaryEndpoint": "https://mcp.wealthtechinnovations.com/deploy/github/stablecoin/s2/fast-forward",
      "runtimeInteractiveAuthRequired": false,
      "constraints": [
        "EXACT_EXPECTED_SERVER_SHA_REQUIRED",
        "EXACT_TARGET_SHA_REQUIRED",
        "MAIN_BRANCH_REQUIRED",
        "CLEAN_WORKTREE_REQUIRED",
        "CANONICAL_ORIGIN_REQUIRED",
        "FAST_FORWARD_ONLY",
        "APPLICATION_DIFF_MUST_BE_ZERO",
        "NO_BUILD",
        "NO_RESTART",
        "BOUNDED_ATTESTATION_ONLY"
      ]
    }
  },
  "preservedAuthorities": [
    "GitHub",
    "Governed Task Queue",
    "Governed Session",
    "Bootstrap Receipt",
    "Governed Locks",
    "Live State",
    "Runtime"
  ],
  "invariants": [
    "GITHUB_AUTH_IS_CONTINUITY_NOT_RUNTIME_AUTHORITY",
    "BRIDGE_IS_CAPABILITY_NOT_BOOTSTRAP_PREREQUISITE",
    "READONLY_FALLBACK_NEVER_AUTHORIZES_SERVER_WRITE",
    "NO_ARBITRARY_SHELL",
    "NO_SERVER_TO_GITHUB_PUSH",
    "NO_DIRECT_VERSIONED_CODE_EDIT_ON_SERVER",
    "FAIL_CLOSED_ON_AMBIGUOUS_OR_MISSING_EVIDENCE",
    "GITHUB_OIDC_READONLY_EVIDENCE_REQUIRES_NO_INTERACTIVE_MCP_AUTH",
    "GITHUB_BOUNDED_WRITE_REQUIRES_DEDICATED_OIDC_WORKFLOW_AND_EXACT_SHA",
    "STABLECOIN_BOUNDED_WRITE_FORBIDS_APPLICATION_DIFF_BUILD_AND_RESTART",
    "PRESERVE_GITHUB_CLIENT_SURFACE_WHEN_GITHUB_OR_APPROVED_FALLBACK_IS_SUFFICIENT",
    "DO_NOT_REQUEST_BRIDGE_FOR_CLIENT_SCHEMA_STALENESS_WHEN_GITHUB_FALLBACK_EXISTS",
    "BRIDGE_ESCALATION_REQUIRES_LIVE_ONLY_JUSTIFICATION_AND_NO_GITHUB_FALLBACK",
    "NO_CLIENT_SURFACE_THRASHING"
  ],
  "clientSurfacePreservation": {
    "githubSurfacePreferred": true,
    "bridgeExposureDefault": false,
    "bridgeExposureMayEvictGithubSurface": true,
    "mandatoryRule": "Do not request or switch to wealthtech_ssh_bridge while GitHub or an approved GitHub fallback can complete the bounded operation.",
    "fallbackOrder": [
      "GITHUB_ONLY",
      "GITHUB_ACTION_READONLY_EVIDENCE",
      "GITHUB_ACTION_BOUNDED_WRITE",
      "RUNTIME_REQUIRED"
    ],
    "bridgeEscalationRequires": [
      "EXACT_OPERATION_IDENTIFIED",
      "LIVE_RUNTIME_AUTHORITY_REQUIRED",
      "NO_APPROVED_GITHUB_FALLBACK_AVAILABLE"
    ],
    "staleClientSchemaRule": "A stale or missing client-side runtime tool schema is not sufficient reason to request bridge exposure when an approved GitHub workflow/issue/OIDC fallback exists.",
    "noSurfaceThrashing": true,
    "rationale": "In clients where exposing the bridge can remove the GitHub surface, unnecessary bridge requests break GitHub-first continuity and can strand the agent away from branch/PR/CI/fallback controls."
  }
}
